\begin{document}
\maketitle

\begin{abstract}
Quantifying reliable epistemic uncertainty in deep neural networks is essential for safety-critical decision-making, active exploration, and robust optimization. However, standard parameter-space Bayesian Neural Networks (BNNs)---including Monte Carlo dropout, variational inference, and deep ensembles---suffer from a fundamental pathology: \textbf{epistemic uncertainty collapse in the data void}. Because neural activations extrapolate linearly away from the training distribution, predictive variance frequently vanishes or behaves erratically in unobserved regions. In sequential decision-making and black-box optimization, this void collapse blinds acquisition functions to unexplored territory, causing algorithms to abandon global exploration and become permanently trapped in suboptimal local basins.

In this work, we propose \textbf{Data-Space Dirichlet Process Bayesian Neural Networks (DP-BNNs)}, a scalable non-parametric Bayesian framework that provably resolves void uncertainty collapse. Rather than placing intractable priors over high-dimensional weight spaces, DP-BNN places a conjugate Dirichlet Process prior directly over the \textbf{unknown data-generating distribution} on the joint input-output space: $\mathcal{P} \sim \mathrm{DP}(\alpha, P_0)$, where the base distribution $P_0$ governs unobserved prior dispersion $\sigma_0^2$. Crucially, because the DP posterior is an infinite-dimensional distribution over probability distributions, sampling a single random measure from the posterior and training a \textbf{single deterministic neural network} directly instantiates an exact functional sample from the posterior function distribution. This enables hyperparameter-free, pure Non-Parametric Thompson Sampling (DP-TS) without multi-head ensembles, stochastic dropout passes, or exploration parameter tuning. Theoretically, we prove an \textbf{Epistemic Exploration Guarantee}: predictive uncertainty strictly reverts to the prior dispersion in unobserved regions ($\lim_{\min_i \|x - x_i\| \to \infty} \sigma(x) \ge \sigma_0 > 0$), mathematically ruling out premature local-trap convergence and guaranteeing vanishing simple optimization regret $\lim_{T \to \infty} S_T = 0$. Empirically, we evaluate DP-BNN across challenging multimodal landscapes (Ackley 2D, Levy 2D) and high-dimensional control benchmarks (Pendulum 32D policy search). Our results demonstrate that a single-network DP-BNN systematically escapes deceptive local traps where conventional BNNs fail (achieving up to $75\times$ error reduction), outperforming exact Gaussian Processes while sustaining linear computational scalability ($\mathcal{O}(t)$) and a rapid 21.6~ms step latency.
\end{abstract}

\section{Introduction}
\label{sec:intro}
Sequential decision-making under uncertainty---encompassing black-box optimization, active learning, and robotic policy search---lies at the frontier of modern scientific discovery and automated machine learning \citep{snoek2012practical,shahriari2015taking}. In these domains, evaluating the objective function $f: \mathcal{X} \to \mathbb{R}$ involves expensive physical experiments, complex numerical simulations, or interactive real-world rollouts. Consequently, the optimization agent must deploy a probabilistic surrogate model to infer the unknown landscape from sparse historical evaluations $\mathcal{D}_t = \{(x_i, y_i)\}_{i=1}^t$, carefully balancing exploitation of identified modes against exploration of unobserved space.

\paragraph{The Gaussian Process Scalability Dilemma.}
Historically, Gaussian Processes (GPs) have served as the gold standard for black-box optimization \citep{rasmussen2006gaussian,srinivas2010gaussian}. Thanks to stationary covariance kernels (e.g., squared exponential or Mat\'ern), the GP predictive variance strictly reverts to the prior marginal variance $\sigma_0^2$ as the test query $x$ moves away from past observations:
\begin{equation}
\label{eq:gp_extrap}
\lim_{\min_{1 \le i \le t} \|x - x_i\| \to \infty} \sigma_{\mathrm{GP}}^2(x) = \sigma_0^2 > 0
\end{equation}
This spatial distance-awareness prevents overconfidence and naturally repels the acquisition function from premature convergence. However, exact GP inference requires inverting a dense $t \times t$ covariance matrix $K_t$, imposing a cubic computational bottleneck $\mathcal{O}(t^3)$ and quadratic memory footprint $\mathcal{O}(t^2)$. This cubic scaling renders GPs intractable for long-horizon optimization or high-throughput batch evaluations. Furthermore, in high-dimensional domains ($d > 10$), stationary kernels suffer from distance concentration: pairwise distances between points concentrate around the expected Euclidean norm, causing the covariance matrix to flatten and degrading GP acquisition to near-random search \citep{wang2018batched,eriksson2019scalable}.

\paragraph{The Pathology: Epistemic Void Uncertainty Collapse.}
To achieve scalable surrogate modeling, deep Bayesian Neural Networks (BNNs) have been widely explored \citep{snoek2015scalable,springenberg2016bayesian}. By training parameterized neural representations, BNNs provide linear computational scaling $\mathcal{O}(t)$ and retain expressive representation learning in high dimensions. 

However, parameter-space BNNs suffer from a well-documented and fatal pathology: \textbf{epistemic uncertainty collapse in the data void} \citep{foong2019inbetween,hein2019why,ober2021promises}. Standard neural activation functions (such as ReLU, SiLU, or GELU) partition the input space into unbounded piecewise-linear polytopes. Outside the convex hull of the training data, hidden features extrapolate linearly along unconstrained rays. When conventional uncertainty techniques---such as Monte Carlo Dropout (MC-Dropout) \citep{gal2016dropout}, deep ensembles \citep{lakshminarayanan2017simple}, or variational weight distributions \citep{blundell2015weight}---are evaluated far from observations, their predictive variance does not reliably expand with distance. Instead, parameter-space BNNs frequently predict near-zero variance or erratic overconfidence in unexplored space.

In sequential optimization, this void collapse produces catastrophic failure. Acquisition strategies (such as Lower Confidence Bounds or Thompson Sampling) rely on high epistemic variance to incentivize exploration into the data void. When the surrogate predicts $\sigma(x) \approx 0$ across unvisited regions, the exploration bonus vanishes, blinding the algorithm to unexplored territory. As a result, the optimizer becomes permanently trapped in the suboptimal local basin surrounding its initial queries (Figure~\ref{fig:bo_showdown}).

\paragraph{The Parameter Ensemble Trap.}
To mitigate this collapse, existing deep exploration methods resort to \textbf{parameter-space ensembles} (e.g., Bootstrapped DQN with randomized priors \citep{osband2016deep,osband2018randomized} or Epistemic Neural Networks \citep{osband2021epistemic}). These approaches train $K$ separate networks or multi-head architectures. However, parameter-space ensembles introduce severe drawbacks:
\begin{enumerate}
    \item \textbf{Computational \& Memory Inflation}: Storing and optimizing $K$ sets of weights scales parameters and GPU memory by $\mathcal{O}(K)$.
    \item \textbf{Subspace Collapse}: When optimized via gradient descent on shared datasets, independent network weights inevitably correlate and collapse into identical local minima.
    \item \textbf{No Functional Measure}: Parameter-space point weights do not define an interpretable measure over function space; functional uncertainty is merely an ad-hoc byproduct of initialization seeds.
\end{enumerate}

\paragraph{Our Solution: Single-Network Data-Space DP-BNN.}
In this work, we propose a foundational departure from parameter-space formulations: \textbf{Data-Space Dirichlet Process Bayesian Neural Networks (DP-BNNs)}. Instead of placing intractable priors over high-dimensional weight matrices $\theta \in \mathbb{R}^P$, we place a conjugate Dirichlet Process prior directly over the \textbf{unknown data-generating distribution} on $\mathcal{X} \times \mathbb{R}$:
\begin{equation}
\label{eq:dp_prior_intro}
\mathcal{P} \sim \mathrm{DP}(\alpha, P_0)
\end{equation}
where $\alpha > 0$ governs concentration and $P_0$ represents our unobserved prior dispersion $\sigma_0^2$.

Conditioned on empirical observations $\mathcal{D}_t$, the posterior $\mathcal{P} \mid \mathcal{D}_t$ is an exact Dirichlet Process over probability distributions \citep{ferguson1973bayesian,vashishtha2025leveraging}. This leads to our central theoretical and algorithmic breakthrough:
\begin{quote}
\textbf{The Single-Network Non-Parametric Specialty}:
Because the Dirichlet Process posterior is an infinite-dimensional distribution over probability distributions, drawing a single realization of the posterior distribution $\mathcal{P}_t$ and optimizing a \textbf{single, deterministic neural network} on it directly generates an exact functional sample from the posterior function distribution:
\begin{equation}
f_{\theta_t} \sim \Pi(\cdot \mid \mathcal{D}_t)
\end{equation}
Selecting $x_{t+1} = \arg\min_{x \in \mathcal{X}} f_{\theta_t}(x)$ executes \textbf{pure, hyperparameter-free Non-Parametric Thompson Sampling (DP-TS)}.
\end{quote}

This discovery completely obviates multi-head architectures, stochastic dropout passes, and exploration parameter tuning ($\beta$). A single standard neural network achieves principled Bayesian exploration with strict linear time complexity $\mathcal{O}(t)$.

\paragraph{Summary of Contributions.}
\begin{enumerate}
    \item \textbf{Data-Space Dirichlet Process Formulation}: We formulate data-space DP priors for continuous function surrogates, solving the geometric void collapse of parameter-space BNNs through exact conjugate posterior distributions over the data-generating process.
    \item \textbf{Single-Network Exact Thompson Sampling}: We establish that a single deterministic neural network trained on a sampled DP random distribution instantiates an exact posterior function sample, completely eliminating multi-head and ensemble memory overhead.
    \item \textbf{Epistemic Exploration Guarantee \& Consistency}: We prove that posterior functional dispersion strictly reverts to the base distribution variance in unobserved regions ($\lim_{\min_i \|x - x_i\| \to \infty} \mathrm{Var}(f_{\theta_t}(x)) \ge \sigma_0^2 > 0$), and establish asymptotic global optimization consistency ($\lim_{T \to \infty} S_T = 0$).
    \item \textbf{Extensive Empirical Verification}: On rugged multimodal landscapes (Ackley 2D and Levy 2D), DP-BNN systematically escapes deceptive local traps where conventional BNNs fail, reducing optimization suboptimality by up to \textbf{75$\times$} and matching or outperforming exact GPs. In 32-dimensional continuous policy search (Pendulum-v1), Single-Network DP-TS achieves the lowest regret across all baselines (927.1 vs. BNN 978.9 and GP 1033.2) with a rapid \textbf{21.6~ms step latency}.
\end{enumerate}

\section{Related Work}
\label{sec:related}

\subsection{Surrogate Models in Bayesian Optimization}
Bayesian optimization (BO) relies on probabilistic surrogate models to guide sequential query decisions over expensive black-box objective functions \citep{mockus1975bayesian,jones1998efficient,brochu2010tutorial}. Gaussian Processes (GPs) have traditionally dominated the literature due to their analytic tractability, flexible kernel definitions, and rigorous Bayesian regret bounds \citep{srinivas2010gaussian,bull2011convergence}. However, exact GPs scale cubically $\mathcal{O}(t^3)$ in the number of evaluated points, imposing prohibitive computational latency as evaluations accumulate. In high dimensions, standard stationary kernels face the curse of dimensionality, motivating dimension-reduction techniques such as random embeddings \citep{wang2016bayesian}, trust-region partitioning (TuRBO) \citep{eriksson2019scalable}, and sparse additive axis-aligned priors (SAASBO) \citep{eriksson2021high}.

To bypass the cubic bottleneck and unlock expressive non-linear representation learning, deep neural network surrogates have garnered significant interest. Early frameworks such as DNGO \citep{snoek2015scalable} used deep feature extractors coupled with Bayesian linear regression heads. \citet{springenberg2016bayesian} proposed RoBO, employing Stochastic Gradient Hamiltonian Monte Carlo (SGHMC) over network weights. Other scalable alternatives include BANANAS \citep{white2021bananas} for neural architecture search and ensemble-based BO \citep{belakaria2020max}. Despite empirical speedups, deep surrogates remain vulnerable to extrapolation artifacts in unobserved search regions.

\subsection{The Epistemic Void Pathology in Deep Uncertainty}
Quantifying epistemic uncertainty in deep learning has predominantly evolved within \textbf{parameter-space} paradigms. These include variational inference \citep{blundell2015weight,hinton1993keeping}, Monte Carlo Dropout (MC-Dropout) \citep{gal2016dropout}, Laplace approximations \citep{daxberger2021laplace}, and Deep Ensembles \citep{lakshminarayanan2017simple}. 

However, a fundamental geometric limitation afflicts parameter-space BNNs: \textbf{epistemic uncertainty collapse in the data void} \citep{foong2019inbetween,hein2019why,ober2021promises}. Because modern neural architectures rely on piecewise-affine activations (e.g., ReLU, SiLU, GELU), the latent space is partitioned into unbounded polyhedral cones. Far outside the support of the training data, features extrapolate along linear rays. Consequently, MC-Dropout and variational ensembles frequently produce vanishing variance ($\sigma(x) \to 0$) or arbitrary overconfidence in unexplored domains \citep{van2020uncertainty}. In sequential decision-making, this void collapse extinguishes acquisition incentives, causing the optimizer to abandon global exploration and permanently trap queries within suboptimal initialization basins.

In deep reinforcement learning and bandit literature, randomized prior functions (RPFs) \citep{osband2018randomized,burda2018exploration} and Epistemic Neural Networks (ENNs) \citep{osband2021epistemic} attempt to induce exploration by adding fixed, random parameter-space priors across $K$ independent networks or multi-head ensembles. Yet, parameter-space ensembles inevitably introduce severe computational overhead: they multiply memory by $\mathcal{O}(K)$, increase training latency, and suffer from gradient-induced subspace collapse, where independent heads correlate under continuous fine-tuning on shared data.

\subsection{Non-Parametric Bayesian Inference in Data Space}
The Dirichlet Process (DP), formalized by \citet{ferguson1973bayesian}, defines a conjugate non-parametric prior over probability distributions. Classic formulations exploit stick-breaking processes \citep{sethuraman1994}, Polya urn schemes \citep{blackwell1973ferguson}, and Chinese Restaurant Processes \citep{aldous1985exchangeability} for infinite mixture modeling and clustering \citep{antoniak1974mixtures,rasmussen1999infinite}. In the non-informative limit, the DP recovers the Bayesian Bootstrap \citep{rubin1981bayesian,newton1994approximate}, which reweights empirical observations according to standard simplex Dirichlet draws.

Recently, \citet{vashishtha2025leveraging} demonstrated that placing Dirichlet Process priors directly over the transition and reward experience space in deep reinforcement learning resolves the pathologies of parameter-space ensembles. Our work adapts and generalizes this data-space non-parametric paradigm to continuous black-box optimization. By establishing that a single deterministic neural network trained on an atomic realization of the DP posterior measure directly instantiates an exact functional sample from the posterior function distribution, DP-BNN bridges non-parametric Bayesian statistics and deep functional optimization without ensemble overhead.

\section{Methodology: Single-Network DP-TS}
\label{sec:method}

\subsection{Problem Setting and Data-Space Formulation}
Let $\mathcal{X} \subset \mathbb{R}^d$ be a compact search domain, and let $f: \mathcal{X} \to \mathbb{R}$ be an unknown, expensive black-box objective function with global minimum:
\begin{equation}
x^* \in \arg\min_{x \in \mathcal{X}} f(x)
\end{equation}
At iteration $t$, the optimizer has collected historical evaluations $\mathcal{D}_t = \{(x_i, y_i)\}_{i=1}^t$, where $y_i = f(x_i) + \epsilon_i$ with zero-mean observation noise $\epsilon_i \sim \mathcal{N}(0, \sigma_{\epsilon}^2)$. We represent our functional surrogate using a \textbf{single} deterministic neural network $f_\theta: \mathcal{X} \to \mathbb{R}$ parameterized by weight vector $\theta \in \Theta \subset \mathbb{R}^P$.

Instead of placing an intractable prior over the non-identifiable parameter space $\Theta$, we place a Dirichlet Process prior directly over the \textbf{unknown data-generating distribution} $\mathcal{P}$ on the joint data space $\mathcal{Z} = \mathcal{X} \times \mathbb{R}$:
\begin{equation}
\label{eq:dp_prior}
\mathcal{P} \sim \mathrm{DP}(\alpha, P_0)
\end{equation}
where $\alpha > 0$ is the total concentration parameter, and $P_0$ is the base prior distribution on $\mathcal{Z}$. The base distribution encapsulates our uninformative global prior over unvisited regions: across the domain, unobserved evaluations have prior mean $\mu_0(x)$ and dispersion variance $\sigma_0^2$:
\begin{equation}
\mathbb{E}_{P_0}[y \mid x] = \mu_0(x), \quad \mathrm{Var}_{P_0}(y \mid x) = \sigma_0^2
\end{equation}

By Ferguson's conjugacy theorem \citep{ferguson1973bayesian}, given $t$ empirical evaluations $\mathcal{D}_t$, the posterior over the data-generating distribution is also a Dirichlet Process:
\begin{equation}
\label{eq:dp_posterior}
\mathcal{P} \mid \mathcal{D}_t \sim \mathrm{DP}\left(\alpha + t, \, \overline{P}_t\right), \quad \text{where} \quad \overline{P}_t = \frac{t}{\alpha + t} \mathbb{P}_t + \frac{\alpha}{\alpha + t} P_0
\end{equation}
where $\mathbb{P}_t = \frac{1}{t}\sum_{i=1}^t \delta_{(x_i, y_i)}$ is the empirical distribution of collected observations.

\subsection{Exact Realization of the Posterior Distribution}
The posterior $\mathrm{DP}(\alpha + t, \overline{P}_t)$ is an infinite-dimensional distribution over probability distributions. To train our neural network, we construct an exact atomic realization of a freshly drawn random distribution $\mathcal{P}_t \sim \mathrm{DP}(\alpha + t, \overline{P}_t)$.

Let $T$ denote the finite truncation level for the base distribution. We draw $T$ synthetic base pseudo-atoms independently from $P_0$:
\begin{equation}
\label{eq:prior_atoms}
\tilde{z}_j = (\tilde{x}_j, \tilde{y}_j) \stackrel{\text{i.i.d.}}{\sim} P_0, \quad j = 1, \dots, T
\end{equation}
where $\tilde{x}_j \sim \mathrm{Uniform}(\mathcal{X})$ and $\tilde{y}_j \sim \mathcal{N}(\mu_0, \sigma_0^2)$.

Conditioned on the union of empirical observations $\mathcal{D}_t = \{z_i\}_{i=1}^t$ and synthetic prior atoms $\{\tilde{z}_j\}_{j=1}^T$, a freshly sampled random distribution $\mathcal{P}_t$ is represented by the atomic discrete measure:
\begin{equation}
\label{eq:random_measure}
\mathcal{P}_t = \sum_{i=1}^t w_i \, \delta_{(x_i, y_i)} + \sum_{j=1}^T \widetilde{w}_j \, \delta_{(\tilde{x}_j, \tilde{y}_j)}
\end{equation}
where the combined atomic weight vector is drawn from a single Dirichlet distribution on the $(t + T - 1)$-simplex:
\begin{equation}
\label{eq:dirichlet_draw}
\mathbf{w}_t = \left(w_1, \dots, w_t, \, \widetilde{w}_1, \dots, \widetilde{w}_T\right) \sim \mathrm{Dirichlet}\left(1, \dots, 1, \, \frac{\alpha}{T}, \dots, \frac{\alpha}{T}\right)
\end{equation}
with $\sum_{i=1}^t w_i + \sum_{j=1}^T \widetilde{w}_j = 1$.

\paragraph{Preservation of Conjugacy Index.}
The sum of Dirichlet concentration parameters assigned to empirical observations is $\sum_{i=1}^t 1 = t$, while the sum over prior pseudo-atoms is $\sum_{j=1}^T \frac{\alpha}{T} = \alpha$. Thus, the expected total mass assigned to historical observations and prior exploration strictly recovers Ferguson's conjugate posterior weights:
\begin{equation}
\mathbb{E}\left[\sum_{i=1}^t w_i\right] = \frac{t}{\alpha + t}, \quad \mathbb{E}\left[\sum_{j=1}^T \widetilde{w}_j\right] = \frac{\alpha}{\alpha + t}
\end{equation}
By the Glivenko-Cantelli theorem, as $T \to \infty$, the discrete empirical measure of base atoms converges weakly almost surely to $P_0$, ensuring that $\mathcal{P}_t$ is an exact realization of $\mathrm{DP}(\alpha + t, \overline{P}_t)$.

\subsection{The Single-Network Push-Forward Map and Posterior Sampling}
We now establish how minimizing the expected risk under a single sampled data-generating distribution $\mathcal{P}_t$ enables a \textbf{single deterministic neural network} to execute exact posterior functional sampling.

Given the realization $\mathcal{P}_t$, we update our single neural network by minimizing the expected loss under $\mathcal{P}_t$:
\begin{equation}
\label{eq:risk_min}
\theta_t = \arg\min_{\theta \in \Theta} \int_{\mathcal{Z}} \big(f_\theta(x) - y\big)^2 \, d\mathcal{P}_t(x, y) = \arg\min_{\theta \in \Theta} \left[ \sum_{i=1}^t w_i \big(f_\theta(x_i) - y_i\big)^2 + \sum_{j=1}^T \widetilde{w}_j \big(f_\theta(\tilde{x}_j) - \tilde{y}_j\big)^2 \right]
\end{equation}
This empirical risk operator defines a push-forward mapping $\Phi: \mathcal{M}_1(\mathcal{Z}) \to C(\mathcal{X})$ from the space of probability distributions to the space of continuous functions:
\begin{equation}
\Phi(\mathcal{P}_t) = f_{\theta_t}
\end{equation}

\begin{quote}
\textbf{The Single-Network Speciality (Exact Functional Posterior Sample)}:
In conventional parameter-space BNNs, the neural parameter $\theta$ is fixed, requiring multiple networks ($K \ge 5$) or stochastic dropout forward passes to simulate functional variance. 

Under our data-space formulation, $\mathcal{P}_t$ is an exact random sample from the infinite-dimensional Dirichlet Process posterior $\mathrm{DP}(\alpha + t, \overline{P}_t)$. Consequently, the deterministic optimization of a \textbf{single neural network} $f_{\theta_t} = \Phi(\mathcal{P}_t)$ produces an \textbf{exact functional draw from the induced posterior distribution over functions}:
\begin{equation}
f_{\theta_t} \sim \Pi(\cdot \mid \mathcal{D}_t)
\end{equation}
\end{quote}

\subsection{Algorithm: Single-Network DP Thompson Sampling (DP-TS)}
Because $f_{\theta_t}$ is already an exact posterior function sample, we do not need to estimate predictive variance, construct confidence bounds, or tune any exploration parameter $\beta$. 

We simply select the greedy minimum under the freshly sampled function:
\begin{equation}
\label{eq:greedy_action}
x_{t+1} = \arg\min_{x \in \mathcal{X}} f_{\theta_t}(x)
\end{equation}
This executes pure, hyperparameter-free \textbf{Non-Parametric Thompson Sampling (DP-TS)}, satisfying exact probability matching:
\begin{equation}
\mathbb{P}\big(x_{t+1} \in A \mid \mathcal{D}_t\big) = \mathbb{P}\big(x^* \in A \mid \mathcal{D}_t\big)
\end{equation}

\begin{algorithm}[t]
\caption{Single-Network DP Thompson Sampling (DP-TS)}
\label{alg:dp_ts}
\begin{algorithmic}[1]
\REQUIRE Objective function $f$, search domain $\mathcal{X}$, concentration $\alpha$, prior dispersion $\sigma_0$, prior atom count $T$, iterations $T_{\mathrm{max}}$.
\STATE Initialize dataset $\mathcal{D}_0 = \{(x_i, y_i)\}_{i=1}^{t_0}$ with $t_0$ initial evaluations.
\STATE Initialize a \textbf{single} neural network $f_\theta: \mathcal{X} \to \mathbb{R}$.
\FOR{$t = t_0$ \TO $T_{\mathrm{max}} - 1$}
    \STATE Standardize empirical targets: $\tilde{y}_i = (y_i - \hat{\mu}_y) / \hat{\sigma}_y$ for $(x_i, y_i) \in \mathcal{D}_t$.
    \STATE Sample $T$ synthetic prior base atoms: $\tilde{x}_j \sim \mathrm{Uniform}(\mathcal{X})$, $\tilde{y}_j \sim \mathcal{N}(0, \sigma_0^2)$ for $j = 1, \dots, T$.
    \STATE Sample random distribution weights: $\mathbf{w}_t \sim \mathrm{Dirichlet}\left(1, \dots, 1, \, \frac{\alpha}{T}, \dots, \frac{\alpha}{T}\right)$.
    \STATE Update single network parameters $\theta_t$ by minimizing weighted risk (\ref{eq:risk_min}) on $\mathcal{D}_t \cup \{(\tilde{x}_j, \tilde{y}_j)\}_{j=1}^T$.
    \STATE Greedy Thompson query selection: $x_{t+1} = \arg\min_{x \in \mathcal{X}} f_{\theta_t}(x)$.
    \STATE Evaluate true objective: $y_{t+1} = f(x_{t+1}) + \epsilon_{t+1}$.
    \STATE Update dataset: $\mathcal{D}_{t+1} = \mathcal{D}_t \cup \{(x_{t+1}, y_{t+1})\}$.
\ENDFOR
\ENSURE Best evaluation $x^* = \arg\min_{(x_i, y_i) \in \mathcal{D}_T} y_i$.
\end{algorithmic}
\end{algorithm}

\subsection{Computational Complexity and Memory Footprint}
\paragraph{Linear Time Scaling.}
Each optimization step requires sampling a $(t + T)$-dimensional Dirichlet vector and running gradient updates on $t + T$ weighted points. Because the prior truncation level $T$ is constant ($T=30$), step complexity scales strictly as $\mathcal{O}(t)$, in stark contrast to exact Gaussian Processes, which require an intractable $\mathcal{O}(t^3)$ cubic Cholesky factorization.

\paragraph{Constant Model Memory.}
Only a single neural network $f_\theta$ is stored and trained in memory. DP-TS requires zero parameter-space ensembles or multi-head structures ($\mathcal{O}(1)$ model memory versus $\mathcal{O}(K)$ for Deep Ensembles), and maintains linear dataset storage ($\mathcal{O}(t)$ versus the quadratic $\mathcal{O}(t^2)$ kernel matrix storage of GPs).

\section{Theoretical Guarantees}
\label{sec:theory}

We now establish two formal properties of Single-Network DP-TS:
(i) \textbf{Non-vanishing epistemic void dispersion} (preventing functional uncertainty collapse in unobserved regions), and 
(ii) \textbf{Global optimization consistency} (establishing asymptotic convergence to the global optimum).

\subsection{Non-Vanishing Epistemic Void Dispersion}
\begin{definition}[The Data Void]
\label{def:data_void}
Let $\mathcal{D}_t = \{x_i\}_{i=1}^t$ denote historical evaluations. For radius $\delta > 0$, the \textbf{data void} $\mathcal{X}_{\mathrm{void}}(\delta) \subset \mathcal{X}$ is the set of points separated from all evaluations by at least Euclidean distance $\delta$:
\begin{equation}
\mathcal{X}_{\mathrm{void}}(\delta) = \left\{ x \in \mathcal{X} : \min_{1 \le i \le t} \|x - x_i\|_2 \ge \delta \right\}
\end{equation}
\end{definition}

In parameter-space BNNs, piecewise-affine activations extrapolate linearly, causing predictive variance to collapse: $\lim_{\delta \to \infty} \sigma_{\mathrm{BNN}}^2(x) \approx 0$ \citep{foong2019inbetween,hein2019why}. In contrast, our data-space DP formulation guarantees non-vanishing dispersion.

\begin{proposition}[Moments of Base Distribution Weight]
\label{prop:dirichlet_moments}
Let $\mathbf{w}_t \sim \mathrm{Dirichlet}(1, \dots, 1, \frac{\alpha}{T}, \dots, \frac{\alpha}{T})$ via (\ref{eq:dirichlet_draw}). The total prior weight $W_{\mathrm{prior}} = \sum_{j=1}^T \widetilde{w}_j$ follows $\mathrm{Beta}(\alpha, t)$, with expectation $\mathbb{E}[W_{\mathrm{prior}}] = \frac{\alpha}{\alpha + t}$ and variance $\mathrm{Var}(W_{\mathrm{prior}}) = \frac{\alpha t}{(\alpha + t)^2 (\alpha + t + 1)}$.
\end{proposition}

\begin{theorem}[Non-Vanishing Epistemic Void Dispersion]
\label{thm:void_dispersion}
Let the base distribution $P_0$ have exploration density $p_0(x) \ge c_{\mathrm{unif}} > 0$ on $\mathcal{X}$ and prior dispersion $\sigma_0^2 > 0$. For any query $x \in \mathcal{X}_{\mathrm{void}}(\delta)$, the variance of $f_{\theta_t}(x)$ across draws of $\mathcal{P}_t$ is strictly bounded:
\begin{equation}
\inf_{x \in \mathcal{X}_{\mathrm{void}}(\delta)} \mathrm{Var}_{\mathcal{P}_t \sim \mathrm{DP}}\big(f_{\theta_t}(x)\big) \ge \frac{\alpha}{\alpha + t + 1} \, \sigma_0^2 > 0, \quad \lim_{\delta \to \infty} \inf_{x \in \mathcal{X}_{\mathrm{void}}(\delta)} \mathrm{Var}_{\mathcal{P}_t}\big(f_{\theta_t}(x)\big) = \sigma_0^2 > 0
\end{equation}
\end{theorem}
\begin{proof}[Proof Sketch]
In the void $\mathcal{X}_{\mathrm{void}}(\delta)$, empirical observations exert zero local pull. By universal approximation under weighted loss (\ref{eq:risk_min}), $f_{\theta_t}(x)$ interpolates local base pseudo-atoms $\tilde{y}_j \sim \mathcal{N}(\mu_0, \sigma_0^2)$. Applying the law of total variance over Dirichlet weights and base targets yields the lower bound $\frac{\alpha}{\alpha + t + 1}\sigma_0^2$. Full proof in Appendix~\ref{app:proof_thm1}.
\end{proof}

\subsection{Asymptotic Support Contraction and Global Optimization Consistency}
\begin{lemma}[Asymptotic Support Contraction]
\label{lem:contraction}
As local evaluation density $t_{\mathrm{local}}(x) \to \infty$, the prior weight vanishes: $\sum_{j \in \mathcal{N}(x)} \widetilde{w}_j \to 0$ almost surely, and $f_{\theta_t}(x) \to f(x)$ uniformly on observed support.
\end{lemma}

In black-box optimization, the primary metric is \textbf{simple regret} (the suboptimality of the best evaluation within budget $T$): $S_T = \min_{1 \le t \le T} f(x_t) - f(x^*)$.

\begin{theorem}[Global Optimization Consistency and Regret Bound]
\label{thm:simple_regret}
Let $f: \mathcal{X} \to \mathbb{R}$ be $L$-Lipschitz continuous on compact domain $\mathcal{X} \subset [0, 1]^d$. Under Single-Network DP-TS (Algorithm~\ref{alg:dp_ts}), the simple regret vanishes:
\begin{equation}
\lim_{T \to \infty} S_T = 0 \quad \text{almost surely, with rate } \mathbb{E}[S_T] \le \mathcal{O}\left( \sqrt{\frac{d \log T}{T}} \right)
\end{equation}
\end{theorem}
\begin{proof}[Proof Sketch]
Because $S_T \le \frac{1}{T}\sum_{t=1}^T (f(x_t) - f^*) = R_T / T$, bounding cumulative regret bounds simple regret. Under probability matching ($x_t \stackrel{d}{=} x^* \mid \mathcal{D}_{t-1}$), the Russo-Van Roy information-theoretic bound yields $\mathbb{E}[R_T] \le \sqrt{\frac{1}{2}\bar{\Gamma} T I(x^*; \mathcal{D}_T)}$. On compact $[0, 1]^d$, covering numbers satisfy $N(\mathcal{X}, \epsilon) \le (1/\epsilon)^d$, bounding mutual information by metric entropy $\mathcal{O}(d \log T)$. Dividing by $T$ yields $\mathbb{E}[S_T] \le \mathcal{O}(\sqrt{\frac{d \log T}{T}}) \to 0$. Full proof in Appendix~\ref{app:proof_thm2}.
\end{proof}

