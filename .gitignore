# ==============================================================================
# Clean Minimal .gitignore for DP-BNN & DP-DQN Repository
# Tracks ONLY core DP-DQN library, figure generation scripts, and reproduction tests.
# ==============================================================================

# Byte-compiled / cache / venvs
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
scratch/
DP-PINNs/
.DS_Store
*.log
*.zip
*.tar.gz
*.mp4
*.gif
*.npz
*.csv
*.data
*.trn*
launch_remote.sh

# Ignore all LaTeX, BibTeX, style files, and paper submission directories
*.tex
*.bib
*.sty
*.bst
TMLR_Camera_Ready_Submission/
aistats_dpps_paper/
dp_bo_iclr2026_submission/
verify_tmlr_submission.py

# Ignore auxiliary research directories and legacy archives
results/
experiments/
dp_bo_supplementary_code/
archive_legacy/
neural_linear_dp_dqn/
scripts/
tests/
test_*/
!test_reproducibility_suite.py
!test_riverswim_std_normal_mlp20.py
results_*/
local_*/
data/

# Ignore auxiliary research modules in src/ and unified_dp_dqn/
src/bayesian_distributional_rl/
src/dp_reinforce/
src/envs/
src/models/
src/launch_60runs_pool.py
src/run_cartpole_full_benchmark.py
unified_dp_dqn/

# Ignore internal roadmaps and scratch reports
*_ROADMAP.md
*ROADMAP*.md
REPORT_*.md
THEORETICAL_*.md

# Ignore miscellaneous root-level scripts, plots, and raw data by default
/*.py
/*.json
/*.png
/*.pdf

# ------------------------------------------------------------------------------
# Whitelist ONLY essential algorithm test & figure generation scripts
# ------------------------------------------------------------------------------
!/test_reproducibility_suite.py
!/run_2d_circular_regression_layernorm_ablation.py
!/plot_Figure_2_TMLR.py
!/plot_Figure_3_TMLR.py
!/test_riverswim_std_normal_mlp20.py

# ------------------------------------------------------------------------------
# Whitelist ONLY verified benchmark data files needed by the plotting scripts
# ------------------------------------------------------------------------------
!/Figure_2_TMLR_data.json
!/Figure_3_TMLR_data.json
!/Figure_RiverSwim_Canonical.json
!/results_option_c_dag_vs_nondag.json
